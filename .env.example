# Smarts Pro Solutions — Automated Email & Calendar Dispatch Configuration
# Copy these variables into your Vercel Project Settings -> Environment Variables.
# Never commit real API keys or secrets to source control.

# Business email address that receives customer estimate & appointment emails
OWNER_NOTIFICATION_EMAIL=smartsprosolutions@gmail.com

# Option A (Free Gmail + Google Calendar Automation via Google Apps Script Web App):
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# Option B (Transactional Email via Resend HTTPS API):
RESEND_API_KEY=
RESEND_FROM_EMAIL="Smarts Pro Solutions <estimates@yourdomain.com>"
